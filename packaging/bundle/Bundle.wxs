<?xml version="1.0" encoding="utf-8"?>
<!--
  The NdalamoPDF setup program (decision 009). Both downloads are built from this file:
  - NdalamoPDF-Setup-<version>.exe: NdalamoPDF and the Word add-in, for this Windows user only.
  - NdalamoPDF-Setup-<version>-with-LibreOffice.exe: the same plus LibreOffice (when LibreOfficeMsi
    is given), which installs for every user, so that one asks for administrator permission once.
  The window is our own (Theme.xml, Theme.wxl, the pictures in this folder); the terms of use are
  shown in it (terms.rtf, made from packaging\terms.txt by the build) and must be accepted.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <!-- Never change the upgrade codes (build-installer.ps1 passes the one for each setup): Windows uses
       them to know a newer setup replaces the installed one. -->
  <Bundle Name="NdalamoPDF"
          Version="$(var.Version)"
          Manufacturer="NdalamoPDF"
          IconSourceFile="$(var.Icon)"
          AboutUrl="https://github.com/Ramudzuli1702/ndalamo-pdf"
          DisableModify="yes"
          UpgradeCode="$(var.BundleUpgradeCode)">
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication LicenseFile="$(var.TermsRtf)" ThemeFile="$(var.Theme)" LocalizationFile="Theme.wxl"
                                              SuppressOptionsUI="yes" SuppressRepair="yes"
                                              LaunchTarget="[LocalAppDataFolder]NdalamoPDF\NdalamoPDF.exe" />
      <Payload SourceFile="panel.png" />
      <Payload SourceFile="setup.ico" />
      <Payload SourceFile="btn-cancel.png" />
      <Payload SourceFile="btn-close.png" />
      <Payload SourceFile="btn-install.png" />
      <Payload SourceFile="btn-ok.png" />
      <Payload SourceFile="btn-open.png" />
      <Payload SourceFile="btn-repair.png" />
      <Payload SourceFile="btn-restart-primary.png" />
      <Payload SourceFile="btn-restart.png" />
      <Payload SourceFile="btn-uninstall.png" />
      <Payload SourceFile="progress.png" />
      <Payload SourceFile="terms-frame.png" />
      <Payload SourceFile="check.png" />
    </BootstrapperApplicationRef>

    <!-- The version as people know it (Windows shows four parts: 1.0.1.0). -->
    <Variable Name="DisplayVersion" Value="$(var.Version)" />
    <!-- Set by the checkboxes of the same names on the first page; all ticked to begin with. -->
    <Variable Name="AddDesktopShortcut" Type="numeric" Value="1" />
    <Variable Name="LaunchAfterInstall" Type="numeric" Value="1" />
    <Variable Name="InstallWordAddIn" Type="numeric" Value="1" />
<?ifdef LibreOfficeMsi ?>
    <Variable Name="InstallLibreOffice" Type="numeric" Value="1" />
    <!--
      The LibreOffice already on the PC, if any, found by LibreOffice's own upgrade code (the same
      for every version). The bundled one is installed when there's none, and replaces an older
      one; a PC with the same or a newer LibreOffice keeps it and this step is skipped.
    -->
    <util:ProductSearch Variable="InstalledLibreOffice" UpgradeCode="{4B17E523-5D91-4E69-BD96-7FD81CFA81BB}" Result="version" />
<?endif ?>

    <Chain>
<?ifdef LibreOfficeMsi ?>
      <!--
        First, so NdalamoPDF opens only when everything is in place. LibreOffice's official, unchanged
        installer, run silently. Permanent: removing NdalamoPDF leaves it (people may use it on its own).
        Its own options: don't take over Office file types, no update checks, no desktop icon, no tray
        quick-starter, never restart Windows by itself.
      -->
      <MsiPackage Id="LibreOffice" DisplayName="LibreOffice" SourceFile="$(var.LibreOfficeMsi)"
                  InstallCondition="InstallLibreOffice = 1 AND (NOT InstalledLibreOffice OR InstalledLibreOffice &lt; v$(var.LibreOfficeVersion))"
                  Vital="no" Permanent="yes" DisplayInternalUI="no">
        <MsiProperty Name="REGISTER_ALL_MSO_TYPES" Value="0" />
        <MsiProperty Name="REGISTER_NO_MSO_TYPES" Value="1" />
        <MsiProperty Name="ISCHECKFORPRODUCTUPDATES" Value="0" />
        <MsiProperty Name="CREATEDESKTOPLINK" Value="0" />
        <MsiProperty Name="QUICKSTART" Value="0" />
        <MsiProperty Name="REBOOTYESNO" Value="No" />
      </MsiPackage>
<?endif ?>
      <MsiPackage Id="NdalamoPDF" DisplayName="NdalamoPDF" SourceFile="$(var.NdalamoMsi)" DisplayInternalUI="no" Vital="yes">
        <!-- The choices on the first page (main.wxs reads them). -->
        <MsiProperty Name="WORDADDIN" Value="[InstallWordAddIn]" />
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[AddDesktopShortcut]" />
        <MsiProperty Name="LAUNCHAPP" Value="[LaunchAfterInstall]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
