<?xml version="1.0" encoding="utf-8"?>
<!-- The words in the NdalamoPDF setup window (Theme.xml). Written for people, not installers. -->
<WixLocalization Culture="en-us" Language="1033" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="Caption">NdalamoPDF Setup</String>
  <String Id="VersionLabel">Version [DisplayVersion]</String>
  <String Id="ConfirmCancelMessage">Stop installing NdalamoPDF?</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">Previous version</String>

  <String Id="InstallHeader">Install NdalamoPDF</String>
  <String Id="InstallMessage">Read the terms of use, then choose your options.</String>
  <String Id="InstallAcceptCheckbox">I accept the terms of use</String>
  <String Id="OptionsLabel">OPTIONS</String>
  <String Id="DesktopShortcutCheckbox">Add a shortcut to the desktop</String>
  <String Id="LaunchCheckbox">Open NdalamoPDF when setup finishes</String>
  <String Id="WordAddInCheckbox">Add Delete Page to Microsoft Word (if Word is on this PC)</String>
  <String Id="LibreOfficeCheckbox">Install LibreOffice, for Word, Excel and PowerPoint to PDF</String>
  <String Id="InstallInstallButton">&amp;Install</String>
  <String Id="InstallCloseButton">Cancel</String>

  <String Id="ProgressHeader">Installing NdalamoPDF</String>
  <String Id="ProgressMessage">This takes about a minute.</String>
  <String Id="ProgressLabel">NOW INSTALLING</String>
  <String Id="OverallProgressPackageText">Getting ready...</String>
  <String Id="ProgressCancelButton">&amp;Cancel</String>

  <String Id="SuccessHeader">All done</String>
  <String Id="SuccessInstallHeader">NdalamoPDF is ready</String>
  <String Id="SuccessRepairHeader">NdalamoPDF is repaired</String>
  <String Id="SuccessUninstallHeader">NdalamoPDF was removed</String>
  <String Id="SuccessMessage">Thank you for choosing NdalamoPDF. Your files never leave your PC.</String>
  <String Id="SuccessLaunchButton">&amp;Open NdalamoPDF</String>
  <String Id="SuccessRestartText">Restart your PC to finish.</String>
  <String Id="SuccessRestartButton">&amp;Restart</String>
  <String Id="SuccessCloseButton">&amp;Close</String>

  <String Id="ModifyHeader">NdalamoPDF is installed</String>
  <String Id="ModifyMessage">You can remove it from this PC. Your own files are not touched.</String>
  <String Id="ModifyRepairButton">&amp;Repair</String>
  <String Id="ModifyUninstallButton">&amp;Uninstall</String>
  <String Id="ModifyCloseButton">&amp;Close</String>

  <String Id="FailureHeader">Setup didn't finish</String>
  <String Id="FailureInstallHeader">NdalamoPDF wasn't installed</String>
  <String Id="FailureUninstallHeader">NdalamoPDF wasn't removed</String>
  <String Id="FailureRepairHeader">NdalamoPDF wasn't repaired</String>
  <String Id="FailureHyperlinkLogText">Nothing on your PC was changed. Close other programs and try again. The details are in the &lt;a href="#"&gt;setup log&lt;/a&gt;.</String>
  <String Id="FailureRestartText">Restart your PC to finish undoing the changes.</String>
  <String Id="FailureRestartButton">&amp;Restart</String>
  <String Id="FailureCloseButton">&amp;Close</String>

  <String Id="FilesInUseHeader">Close some programs first</String>
  <String Id="FilesInUseLabel">These programs are using files that setup needs to update:</String>
  <String Id="FilesInUseCloseRadioButton">Close them for me and open them again afterwards</String>
  <String Id="FilesInUseDontCloseRadioButton">Leave them open (you'll need to restart your PC)</String>
  <String Id="FilesInUseOkButton">&amp;OK</String>
  <String Id="FilesInUseCancelButton">&amp;Cancel</String>

  <String Id="OptionsHeader">Options</String>
  <String Id="OptionsLocationLabel">Install location:</String>
  <String Id="OptionsBrowseButton">&amp;Browse</String>
  <String Id="OptionsOkButton">&amp;OK</String>
  <String Id="OptionsCancelButton">&amp;Cancel</String>

  <String Id="HelpHeader">Setup help</String>
  <String Id="HelpText">/install, /uninstall: install or remove NdalamoPDF.
/passive, /quiet: show only progress, or nothing at all.
/norestart: never restart the PC.
/log log.txt: write the setup log to this file.</String>
  <String Id="HelpCloseButton">&amp;Close</String>
  <String Id="ErrorFailNoActionReboot">Nothing was done because Windows needs a restart first.</String>
</WixLocalization>
